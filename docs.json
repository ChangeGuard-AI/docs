{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "ChangeGuard",
  "description": "Deployment safety intelligence for Kubernetes. Documentation, security architecture, and API reference.",
  "colors": {
    "primary": "#00FFA3",
    "light": "#00FFA3",
    "dark": "#00D98F"
  },
  "favicon": "/favicon.svg",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Getting Started",
            "pages": [
              "introduction",
              "quickstart",
              "how-it-works"
            ]
          },
          {
            "group": "Agent",
            "pages": [
              "agent/installation",
              "agent/configuration",
              "agent/troubleshooting"
            ]
          },
          {
            "group": "Platform",
            "pages": [
              "platform/csc-score",
              "platform/argocd",
              "platform/notifications",
              "platform/export"
            ]
          },
          {
            "group": "Security",
            "pages": [
              "security/architecture",
              "security/agent-security",
              "security/data-handling",
              "security/authentication",
              "security/api-keys",
              "security/compliance"
            ]
          },
          {
            "group": "Releases",
            "pages": [
              "changelog"
            ]
          }
        ]
      },
      {
        "tab": "API Reference",
        "groups": [
          {
            "group": "API Reference",
            "pages": [
              "api-reference/overview",
              "api-reference/authentication",
              "api-reference/ingest",
              "api-reference/validate",
              "api-reference/clusters",
              "api-reference/score-history"
            ]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Website",
          "icon": "globe",
          "href": "https://changeguard.ai"
        },
        {
          "anchor": "Contact",
          "icon": "envelope",
          "href": "mailto:support@changeguard.ai"
        }
      ]
    }
  },
  "navbar": {
    "links": [
      {
        "label": "Dashboard",
        "href": "https://app.changeguard.ai"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Start Free",
      "href": "https://app.changeguard.ai/signup"
    }
  },
  "footer": {
    "socials": {
      "website": "https://changeguard.ai",
      "linkedin": "https://linkedin.com/company/changeguard"
    }
  }
}
